rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed-in app users can read stores and deals. Only the backend writes.
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /deals/{dealId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // The monthly Sam's Club stock-up list.
    match /clubLists/{listId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Each user can see and delete their own meal plans, and save check marks.
    // Plans are created only by the backend.
    match /plans/{planId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checked']);
      allow create: if false;
    }
    // Each user can read their own account (premium status). Only the backend writes it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Everything else (tester codes, usage counts, run logs) is backend-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
