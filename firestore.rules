rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed-in app users can read stores and deals. Only the backend writes.
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /deals/{dealId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Deals shoppers shared from social media. Votes go through the backend.
    match /sharedDeals/{dealId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // The monthly Sam's Club stock-up list.
    match /clubLists/{listId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Each user can see and delete their own meal plans, and save check marks.
    // Plans are created only by the backend.
    match /plans/{planId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checked']);
      allow create: if false;
    }
    // Live progress of a plan being made, so the app can show meals as they're written.
    // The app starts watching before the backend creates the doc, so a missing doc is allowed.
    match /planProgress/{progressId} {
      allow get: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow list, write: if false;
    }
    // Meals and plans shared by link (copies, with no user id). Anyone with the link can open
    // one by its random id, even before signing in; nobody can list them. Only the backend writes.
    match /sharedMeals/{shareId} {
      allow get: if true;
      allow list, write: if false;
    }
    // Each user can read their own account (premium status). Only the backend writes it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Shared shopping list. Members can read their household (who's in it); only the backend
    // changes membership (functions/src/households.ts). Members read and write the list directly.
    match /households/{householdId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow write: if false;

      function isMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
      function validItem(d) {
        return d.keys().hasOnly(['text', 'note', 'aisle', 'checked', 'addedBy', 'addedByName', 'checkedBy',
                                 'forMeals', 'storeName', 'createdAt', 'updatedAt'])
          && d.text is string && d.text.size() > 0 && d.text.size() <= 120
          && d.checked is bool
          && d.addedBy is string
          && (!('note' in d) || (d.note is string && d.note.size() <= 120))
          && (!('aisle' in d) || (d.aisle is string && d.aisle.size() <= 40))
          && (!('addedByName' in d) || (d.addedByName is string && d.addedByName.size() <= 30))
          && (!('checkedBy' in d) || d.checkedBy is string)
          && (!('forMeals' in d) || (d.forMeals is list && d.forMeals.size() <= 10))
          && (!('storeName' in d) || (d.storeName is string && d.storeName.size() <= 80))
          && (!('createdAt' in d) || d.createdAt is timestamp)
          && (!('updatedAt' in d) || d.updatedAt is timestamp);
      }
      match /items/{itemId} {
        allow read, delete: if isMember();
        allow create: if isMember() && validItem(request.resource.data)
          && request.resource.data.addedBy == request.auth.uid;
        allow update: if isMember() && validItem(request.resource.data)
          && request.resource.data.addedBy == resource.data.addedBy;
      }
    }
    // Everything else (tester codes, usage counts, run logs) is backend-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
